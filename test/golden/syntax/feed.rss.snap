@output_buffer = output_buffer || ActionView::OutputBuffer.new


@output_buffer.safe_concat("<?xml version=\"1.0\" encoding=\"utf-8\" ?><rss version=\"2.0\"><channel><title>".freeze); @output_buffer << (title)
@output_buffer.safe_concat("</title><link>".freeze); @output_buffer << (url)
