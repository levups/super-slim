_buf = +""


_buf << "<?xml version=\"1.0\" encoding=\"utf-8\" ?><rss version=\"2.0\"><channel><title>".freeze; _buf << ::ERB::Escape.html_escape((title))
_buf << "</title><link>".freeze; _buf << ::ERB::Escape.html_escape((url))
_buf << "</link>".freeze; posts.each do |post|

_buf << "<item><title>".freeze; _buf << ::ERB::Escape.html_escape((post.title))

_buf << "</title><pubDate>Fri, 30 Oct 2026 10:00:00 +0000</pubDate><enclosure".freeze; case (_super_slim1 = post.url); when true; _buf << " url=\"\"".freeze; when false, nil; else; _buf << " url=\"".freeze; _buf << ::ERB::Escape.html_escape((_super_slim1)); _buf << "\"".freeze; end
_buf << " length=\"0\" type=\"image/webp\" /><guid".freeze; case (_super_slim2 = no); when true; _buf << " isPermaLink=\"\"".freeze; when false, nil; else; _buf << " isPermaLink=\"".freeze; _buf << ::ERB::Escape.html_escape((_super_slim2)); _buf << "\"".freeze; end; _buf << ">".freeze; _buf << ::ERB::Escape.html_escape((post.id))
_buf << "</guid></item>".freeze; end; _buf << "</channel></rss>".freeze; _buf
