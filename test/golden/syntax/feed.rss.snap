~~~~~~~~ super_slim: fmt
doctype xml
rss version="2.0"
  channel
    title = title
    link = url
    - posts.each do |post|
      item
        title = post.title
        pubDate Fri, 30 Oct 2026 10:00:00 +0000
        enclosure url=post.url length="0" type="image/webp"
        guid isPermaLink=no = post.id
