@output_buffer = output_buffer || ActionView::OutputBuffer.new




@output_buffer.safe_concat("<p>First line\ncontinued on a second line\n  and an indented thirdEscaped \#{not interpolated}</p><p>Inline ".freeze); @output_buffer << (title); @output_buffer.safe_concat(" and ".freeze); @output_buffer.safe_concat((markup).to_s)
@output_buffer.safe_concat(" raw</p><p>Unicode: ".freeze); @output_buffer << (unicode)











@output_buffer.safe_concat("</p>Top level text with & and < and ><div class=\"inline-html\"><p>inside inline html</p></div><p>Text with apostrophe marker Final</p><p>Block starting on the next line\nwith two lines</p>".freeze); @output_buffer
