@output_buffer = output_buffer || ActionView::OutputBuffer.new








@output_buffer.safe_concat("<p><a href=\"/a\">after</a>  <a href=\"/b\">before</a> <a href=\"/c\">both</a> <a href=\"/d\">apostrophe</a><span>text</span>trailing space text no space leading space".freeze); @output_buffer << (title)
