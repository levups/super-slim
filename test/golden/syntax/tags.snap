~~~~~~~~ super_slim: html
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Posts &amp; comments</title></head><body><header id="top" class="site-header sticky"><nav><ul class="menu"><li><a href="/">Home</a></li><li><a href="/about">About</a></li></ul></nav></header><div class="card"><div id="anonymous-id"></div><p class="lead">Lead paragraph</p></div><br><hr><img src="/a.png" alt=""><input type="text" name="q"><custom-element some-attribute="1"></custom-element><svg viewBox="0 0 10 10"><path d="M0 0L10 10"></path></svg><p></p></body></html>
~~~~~~~~ super_slim: tilt
_buf = +""



_buf << "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>".freeze; _buf << ::ERB::Escape.html_escape((title))
















_buf << "</title></head><body><header id=\"top\" class=\"site-header sticky\"><nav><ul class=\"menu\"><li><a href=\"/\">Home</a></li><li><a href=\"/about\">About</a></li></ul></nav></header><div class=\"card\"><div id=\"anonymous-id\"></div><p class=\"lead\">Lead paragraph</p></div><br><hr><img src=\"/a.png\" alt=\"\"><input type=\"text\" name=\"q\"><custom-element some-attribute=\"1\"></custom-element><svg viewBox=\"0 0 10 10\"><path d=\"M0 0L10 10\"></path></svg><p></p></body></html>".freeze; _buf
~~~~~~~~ super_slim: rails
@output_buffer = output_buffer || ActionView::OutputBuffer.new



@output_buffer.safe_concat("<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>".freeze); @output_buffer << (title)
















@output_buffer.safe_concat("</title></head><body><header id=\"top\" class=\"site-header sticky\"><nav><ul class=\"menu\"><li><a href=\"/\">Home</a></li><li><a href=\"/about\">About</a></li></ul></nav></header><div class=\"card\"><div id=\"anonymous-id\"></div><p class=\"lead\">Lead paragraph</p></div><br><hr><img src=\"/a.png\" alt=\"\"><input type=\"text\" name=\"q\"><custom-element some-attribute=\"1\"></custom-element><svg viewBox=\"0 0 10 10\"><path d=\"M0 0L10 10\"></path></svg><p></p></body></html>".freeze); @output_buffer
~~~~~~~~ super_slim: fmt
doctype html
html lang="en"
  head
    meta charset="utf-8"
    title = title
  body
    header#top.site-header.sticky
      nav: ul.menu
        li: a href="/" Home
        li: a href="/about" About
    .card
      #anonymous-id
      p.lead Lead paragraph
    br
    hr/
    img src="/a.png" alt=""
    input type="text" name="q"
    custom-element some-attribute="1"
    svg viewBox="0 0 10 10"
      path d="M0 0L10 10"
    p
