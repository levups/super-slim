_buf << "<p>yes</p>".freeze; elsif no

_buf << "<p>no</p>".freeze; else

_buf << "<p>else</p>".freeze; end; unless no

_buf << "<p>unless</p>".freeze; end; case symbol
when :primary

_buf << "<p>primary</p>".freeze; when :secondary

_buf << "<p>secondary</p>".freeze; else

_buf << "<p>other</p>".freeze; end; items.each_with_index do |item, index|
_buf << "<li id=\"item-".freeze; _buf << ::ERB::Escape.html_escape((index)); _buf << "\">".freeze; _buf << ::ERB::Escape.html_escape((item))
_buf << "</li>".freeze; end; items.each do |item|
next if item == "two"
_buf << ::ERB::Escape.html_escape((item))
end; total = items.sum(&:size)
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((total))
_buf << "</p>".freeze; long = [1,
2, 3].sum
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((long))
_buf << "</p>".freeze; begin
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((Integer("x")))
_buf << "</p>".freeze; rescue ArgumentError

_buf << "<p>rescued</p>".freeze; end; while false do

_buf << "<p>never</p>".freeze; end; posts.each do |post|

_buf << "<article><h2>".freeze; _buf << ::ERB::Escape.html_escape((post.title))
_buf << "</h2></article>".freeze; end; _buf
