~~~~~~~~ super_slim: fmt
.a.b class="c" Static merge
.a class=symbol Shortcut and dynamic
p class=classes Array
p class=nothing Nil class
p class=empty Empty class
p.a class=nothing Shortcut and nil
p class=["x", "y"] class="z" Two class attributes
p class=[] Empty array
.a class=(yes ? "on" : nil) class=no Conditional
p class="#{symbol} static" Interpolated
p.a.b.c#id class="d" Many shortcuts
p class=markup Escaped class
