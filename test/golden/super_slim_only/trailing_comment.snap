@output_buffer.safe_concat((safe_markup).to_s)
@output_buffer.safe_concat("<p>".freeze); @output_buffer << (number)

@output_buffer.safe_concat("</p><p>after a sibling</p>".freeze); _super_slim1 = wrap do

@output_buffer.safe_concat("<span>inside</span>".freeze); end; @output_buffer << (_super_slim1); _super_slim2 = wrap do

