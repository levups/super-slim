_buf << (safe_markup).to_s
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((number))

_buf << "</p><p>after a sibling</p>".freeze; _super_slim1 = wrap do; _super_slim2 = +""

_super_slim2 << "<span>inside</span>".freeze; _super_slim2; end; _buf << ::ERB::Escape.html_escape((_super_slim1)); _super_slim3 = wrap do; _super_slim4 = +""

_super_slim4 << "<span>inside</span>".freeze; _super_slim4; end; _buf << ::ERB::Escape.html_escape((_super_slim3))
_buf << "<ul>".freeze; items.each_with_index do
_buf << "<li>".freeze; _buf << ::ERB::Escape.html_escape((items.first))
_buf << "</li>".freeze; end; _buf << "</ul>".freeze; count = items.size
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((count))
_buf << "</p>".freeze; total = count \
# alone on a continued line
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((total))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape(("#{title} # inside a string"))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape(("#not a comment"))
_buf << "</p>".freeze; _buf << ::ERB::Escape.html_escape((format(
"%s and %s",
"alice", # inside the call
"bob",
)))
