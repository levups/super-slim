~~~~~~~~ super_slim: tilt
_buf = +""; names = [
"alice",
"bob",
]
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((names.join(", ")))
_buf << "</p>".freeze; words = %w[
alice
bob
]
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((words.join(" ")))
_buf << "</p>".freeze; options = {
class: "badge",
title: "alice",
}
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((options.values.join(" ")))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape((format(
"%s and %s",
"alice",
"bob",
)))
_buf << "</p>".freeze; _buf << ::ERB::Escape.html_escape((format(
"%s, %s",
*names,
)))

_buf << "<ul>".freeze; names.map(
&:upcase
).each do |name|
_buf << "<li>".freeze; _buf << ::ERB::Escape.html_escape((name))
_buf << "</li>".freeze; end; _buf << "</ul><p>".freeze; _buf << ::ERB::Escape.html_escape((format("(%s", "alice")))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape((format(
"%s) and %s",
"alice",
"bob",
)))
_buf << "</p>".freeze; closings = %w[
a)
b(
]
_buf << "<p>".freeze; _buf << ::ERB::Escape.html_escape((closings.join(" ")))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape((format(
"%s #{"(" + names.first}",
# a comment (
"bob",
)))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape((format( # alice (
"%s",
"bob's".sub(names.any? ? /'s/ : "", ""),
)))
_buf << "</p><p>".freeze; _buf << ::ERB::Escape.html_escape((%(
alice
).strip))
_buf << "</p>".freeze; _buf
