~~~~~~~~ super_slim: fmt
- names = [
    "alice",
    "bob",
  ]
p = names.join(", ")
- words = %w[
    alice
    bob
  ]
p = words.join(" ")
- options = {
    class: "badge",
    title: "alice",
  }
p = options.values.join(" ")
p = format(
    "%s and %s",
    "alice",
    "bob",
  )
= format(
    "%s, %s",
    *names,
  )
ul
  - names.map(
        &:upcase
      ).each do |name|
    li = name
p = format("(%s", "alice")
p = format(
    "%s) and %s",
    "alice",
    "bob",
  )
- closings = %w[
    a)
    b(
  ]
p = closings.join(" ")
p = format(
    "%s #{"(" + names.first}",
    # a comment (
    "bob",
  )
p = format( # alice (
    "%s",
    "bob's".sub(names.any? ? /'s/ : "", ""),
  )
p = %(
    alice
  ).strip
~~~~~~~~ super_slim: lint
