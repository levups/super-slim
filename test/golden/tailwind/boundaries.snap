_buf = +""





_buf << "<li class=\"item\"><a class=\"underline\" href=\"/\">Nested tag after a colon and a space</a></li><img class=\"w-[3px] h-auto\"><a class=\"btn\" href=\"/\">Attribute list in parentheses</a><a class=\"btn\" href=\"/\">Attribute list in braces</a><a class=\"btn\" href=\"/\">Brackets after a space stay an attribute list</a><div id=\"main\" class=\"p-[2px]\">Id then class</div><div class=\"p-2\">".freeze; _buf << ::ERB::Escape.html_escape((title))


_buf << "</div><div class=\"p-[2px]\"><span>Nested after arbitrary value</span></div><a class=\"btn\" href=\"/\">Brackets glued to a class name stay an attribute list</a><th class=\"text-nowrap\" colspan=\"6\">".freeze; _buf << ::ERB::Escape.html_escape((title))
_buf << "</th>".freeze; _buf
~~~~~~~~ slimx: rails
@output_buffer = output_buffer || ActionView::OutputBuffer.new





@output_buffer.safe_concat("<li class=\"item\"><a class=\"underline\" href=\"/\">Nested tag after a colon and a space</a></li><img class=\"w-[3px] h-auto\"><a class=\"btn\" href=\"/\">Attribute list in parentheses</a><a class=\"btn\" href=\"/\">Attribute list in braces</a><a class=\"btn\" href=\"/\">Brackets after a space stay an attribute list</a><div id=\"main\" class=\"p-[2px]\">Id then class</div><div class=\"p-2\">".freeze); @output_buffer << (title)


@output_buffer.safe_concat("</div><div class=\"p-[2px]\"><span>Nested after arbitrary value</span></div><a class=\"btn\" href=\"/\">Brackets glued to a class name stay an attribute list</a><th class=\"text-nowrap\" colspan=\"6\">".freeze); @output_buffer << (title)
@output_buffer.safe_concat("</th>".freeze); @output_buffer
