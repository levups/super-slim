~~~~~~~~ slimx: rails
@output_buffer = output_buffer || ActionView::OutputBuffer.new







@output_buffer.safe_concat("<div class=\"hover:underline focus-visible:outline\">Variants</div><div class=\"!font-bold font-bold!\">Important</div><div class=\"@container\"><div class=\"@lg:flex\">Container queries</div></div><ul class=\"*:p-2\"><li>Child variant</li></ul><div class=\"dark:md:hover:bg-white/10\">Stacked variants and opacity</div><div class=\"mx-0.5 py-1.5 w-1/2\">Decimals and fractions</div>".freeze); @output_buffer
