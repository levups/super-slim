#!/usr/bin/env ruby
# frozen_string_literal: true

# Releases the gem. CHANGELOG.md's Unreleased section becomes the version's, the version constant is bumped,
# and the commit is pushed to main with a signed tag vX.Y.Z. That tag starts .github/workflows/release.yml,
# which publishes the gem to RubyGems and the GitHub release. The same file in every next-gen-gems gem.
#
#   bin/release minor              # or patch, major, or an exact version such as 1.2.0
#   bin/release minor --dry-run    # shows the notes and the changes, touches nothing
#
# Used by the release workflow too:
#
#   bin/release --check v1.2.0     # fails unless the tag matches the gemspec's version and has notes
#   bin/release --notes v1.2.0     # the GitHub release notes: the version's section of CHANGELOG.md
#   bin/release --title v1.2.0     # the GitHub release title, "SlimX 1.2.0"

require "date"
require "json"
require "open3"
require "optparse"
require "rubygems"
require "tempfile"

CHANGELOG = "CHANGELOG.md"
REFERENCE = /^\[([^\]]+)\]: (\S+)$/

def run(*command)
  output, status = Open3.capture2e(*command)
  abort "#{command.join(" ")} failed:\n#{output}" unless status.success?
  output
end

# A version's section: its heading, then everything up to the next heading or the reference links.
def section(version)
  /^## \[#{Regexp.escape(version)}\][^\n]*\n(.*?)(?=^## |^\[[^\]]+\]: |\z)/m
end

spec = Gem::Specification.load(Dir["*.gemspec"].first) or abort "No gemspec here"
current = spec.version
repo_url = spec.metadata["source_code_uri"] || spec.homepage
display_name = File.read("README.md", encoding: "UTF-8")[/\A# (\S+)/, 1] || spec.name
changelog = File.read(CHANGELOG, encoding: "UTF-8")

mode = :release
dry_run = false
assume_yes = false
OptionParser.new do |parser|
  parser.banner = "Usage: bin/release (patch | minor | major | X.Y.Z) [--dry-run] [--yes]"
  parser.on("--dry-run", "Show the notes and the changes, touch nothing") { dry_run = true }
  parser.on("--yes", "Do not ask before pushing") { assume_yes = true }
  parser.on("--check", "Fail unless the tag given matches the gemspec's version and has notes") { mode = :check }
  parser.on("--notes", "Print the release notes of the tag given") { mode = :notes }
  parser.on("--title", "Print the release title of the tag given") { mode = :title }
end.parse!
argument = ARGV.shift or abort "Which version? patch, minor, major or X.Y.Z (bin/release --help)"

if mode != :release
  version = argument.delete_prefix("v")
  notes = changelog[section(version), 1].to_s.strip
  case mode
  when :check
    abort "Tag #{argument}, but #{spec.name}.gemspec says #{current}" unless version == current.to_s
    abort "#{CHANGELOG} has no notes for #{version}" if notes.empty?
    puts "#{argument} matches #{spec.name} #{current}"
  when :notes
    abort "#{CHANGELOG} has no notes for #{version}" if notes.empty?
    compare = changelog.scan(REFERENCE).to_h[version]
    puts notes
    puts "", "**Full diff**: #{compare}" if compare&.include?("/compare/")
  when :title
    puts "#{display_name} #{version}"
  end
  exit
end

major, minor, patch = current.segments.first(3).fill(0, current.segments.size...3)
target = Gem::Version.new(
  case argument
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  when "patch" then "#{major}.#{minor}.#{patch + 1}"
  else argument.delete_prefix("v")
  end
)
tag = "v#{target}"

# The tree, the branch, the tags and CI.
abort "Uncommitted changes:\n#{run("git", "status", "--short")}" unless run("git", "status", "--porcelain").empty?
branch = run("git", "branch", "--show-current").strip
abort "On #{branch}: releases are cut from main" unless branch == "main"
run("git", "fetch", "--quiet", "--tags", "origin", "main")
head = run("git", "rev-parse", "HEAD").strip
abort "main is not origin/main: pull or push first" unless head == run("git", "rev-parse", "origin/main").strip
released = run("git", "tag", "--list", "v*").split.map { |name| Gem::Version.new(name.delete_prefix("v")) }
abort "#{target} is not above #{released.max}, the last release" if released.any? && target <= released.max
abort "#{target} is below #{current}, the gemspec's version" if target < current
previous = released.max

runs = JSON.parse(run("gh", "run", "list", "--commit", head, "--workflow", "ci.yml", "--json", "status,conclusion,url"))
unless runs.first&.fetch("conclusion") == "success"
  state = runs.first ? runs.first.values_at("status", "conclusion", "url").join(" ").squeeze(" ") : "no run"
  abort "CI is not green on #{head[0, 7]} (#{state}): wait for it, or fix it"
end

# CHANGELOG.md: the Unreleased entries become the version's section, unless a commit already wrote it.
unreleased = changelog[section("Unreleased"), 1].to_s.strip
if changelog.match?(section(target.to_s))
  abort "#{CHANGELOG} has a #{target} section and Unreleased entries: move them" unless unreleased.empty?
else
  abort "#{CHANGELOG}'s Unreleased section is empty: nothing to release" if unreleased.empty?
  changelog = changelog.sub(section("Unreleased"), "## [Unreleased]\n\n## [#{target}] — #{Date.today.iso8601}\n\n#{unreleased}\n\n")
end

# Reference links at the end: Unreleased compares with the new tag, then each version newest first.
references = changelog.scan(REFERENCE).to_h
references["Unreleased"] = "#{repo_url}/compare/#{tag}...HEAD"
references[target.to_s] = previous ? "#{repo_url}/compare/v#{previous}...#{tag}" : "#{repo_url}/releases/tag/#{tag}"
unreleased_link = references.delete("Unreleased")
versions = references.sort_by { |name, _url| Gem::Version.new(name) }.reverse
links = [["Unreleased", unreleased_link], *versions].map { |name, url| "[#{name}]: #{url}" }
changelog = "#{changelog.gsub(/^#{REFERENCE.source}\n?/, "").rstrip}\n\n#{links.join("\n")}\n"

# The version constant, and Gemfile.lock where it is committed.
changes = {CHANGELOG => changelog}
if target != current
  constant = /^(\s*VERSION = )(["'])#{Regexp.escape(current.to_s)}\2/
  holders = Dir["lib/**/version.rb"].select { |path| File.read(path).match?(constant) }
  abort "Expected one VERSION = \"#{current}\" in lib/**/version.rb, found #{holders}" unless holders.one? && File.read(holders.first).scan(constant).one?
  changes[holders.first] = File.read(holders.first).sub(constant) { "#{$1}#{$2}#{target}#{$2}" }
  unless run("git", "ls-files", "Gemfile.lock").empty?
    lock = File.read("Gemfile.lock").sub(/^(    #{Regexp.escape(spec.name)} \()#{Regexp.escape(current.to_s)}\)/) { "#{$1}#{target})" }
    changes["Gemfile.lock"] = lock
  end
end
changes.reject! { |path, text| File.read(path, encoding: "UTF-8") == text }

puts "#{display_name} #{current} → #{target}, tagged #{tag} on main", ""
puts changelog[section(target.to_s), 1].strip, ""
if dry_run
  changes.each do |path, text|
    Tempfile.create do |file|
      file.write(text)
      file.flush
      diff = Open3.capture2("git", "diff", "--no-index", "--src-prefix=", "--dst-prefix=", path, file.path).first
      puts diff.gsub(/\S*#{Regexp.escape(File.basename(file.path))}/, path)
    end
  end
  puts "Dry run: nothing written"
  exit
end

unless assume_yes
  print "Push #{tag} and publish #{spec.name} #{target} to RubyGems? [y/N] "
  abort "Stopped" unless $stdin.gets.to_s.strip.casecmp?("y")
end

changes.each { |path, text| File.write(path, text) }
run("git", "commit", "--quiet", "-m", "Release #{target}", "--", *changes.keys) if changes.any?
run("git", "tag", "--annotate", "--sign", tag, "-m", "#{display_name} #{target}")
run("git", "push", "--atomic", "origin", "main", tag)
puts "Pushed #{tag}: #{repo_url}/actions/workflows/release.yml publishes it to RubyGems, then #{repo_url}/releases/tag/#{tag}"
