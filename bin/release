#!/usr/bin/env ruby
# frozen_string_literal: true

# Releases the gem through a pull request, as main takes no direct push. CHANGELOG.md's Unreleased section
# becomes the version's and the version constant is bumped on a branch release/vX.Y.Z, whose pull request merges
# itself once CI is green. Its merge starts .github/workflows/release.yml, which waits for the release environment's
# approval, tags the merge commit vX.Y.Z, and publishes the gem to RubyGems and the GitHub release. The same file in
# every Level UP Solutions gem.
#
#   bin/release minor              # or patch, major, or an exact version such as 1.2.0
#   bin/release minor --dry-run    # shows the notes and the changes, touches nothing
#   bin/release minor --write      # writes the changes and stops, for a pull request opened by hand
#   bin/release --wait 1.2.0       # waits for the release pull request, then opens its approval (after a Ctrl-C)
#
# Used by the release workflow too:
#
#   bin/release --check v1.2.0     # fails unless the tag matches the gemspec's version and has notes
#   bin/release --commit v1.2.0    # the release commit: the one that brought main the version and its notes
#   bin/release --notes v1.2.0     # the GitHub release notes: the version's section of CHANGELOG.md
#   bin/release --title v1.2.0     # the GitHub release title: the README's name, then 1.2.0

require "date"
require "json"
require "open3"
require "optparse"
require "rubygems"
require "tempfile"
require "tmpdir"

CHANGELOG = "CHANGELOG.md"
REFERENCE = /^\[([^\]]+)\]: (\S+)$/

# Returns what the command writes on stdout: callers parse it (JSON, a branch, a commit), so whatever it writes on
# stderr (gh's hints, git's progress) is shown only when it fails.
def run(*command, **options)
  output, errors, status = Open3.capture3(*command, **options)
  abort "#{command.join(" ")} failed:\n#{output}#{errors}" unless status.success?
  output
end

# A version's section: its heading, then everything up to the next heading or the reference links.
def section(version)
  /^## \[#{Regexp.escape(version)}\][^\n]*\n(.*?)(?=^## |^\[[^\]]+\]: |\z)/m
end

spec = Gem::Specification.load(Dir["*.gemspec"].first) or abort "No gemspec here"
current = spec.version
repo_url = spec.metadata["source_code_uri"] || spec.homepage
# The README's title, past a logo: "# <img src=\"docs/logo.svg\" alt=\"\"> Maptain" names Maptain.
display_name = File.read("README.md", encoding: "UTF-8")[/\A# (?:<[^>]*>\s*)*([^\s<]+)/, 1] || spec.name
changelog = File.read(CHANGELOG, encoding: "UTF-8")

# Waits for the release pull request to merge, then opens the release workflow's run, which waits for approval.
# Stops when the pull request can't merge by itself: closed, auto-merge turned off, or a required check failed.
publish = lambda do |target|
  tag = "v#{target}"
  branch = "release/#{tag}"
  resume = "bin/release --wait #{target} picks up from there"
  puts "Waiting for #{branch} to merge (Ctrl-C stops waiting; #{resume})"
  commit = loop do
    output, status = Open3.capture2("gh", "pr", "view", branch, "--json", "state,url,mergeCommit,autoMergeRequest")
    if status.success? # otherwise GitHub didn't answer: ask again
      pull_request = JSON.parse(output)
      url = pull_request["url"]
      oid = pull_request.dig("mergeCommit", "oid")
      break oid if pull_request["state"] == "MERGED" && oid
      abort "#{url} was closed unmerged: #{tag} not released" if pull_request["state"] == "CLOSED"
    end
    if status.success? && pull_request["state"] == "OPEN"
      abort "#{url} has auto-merge off: merge it, then #{resume}" if pull_request["autoMergeRequest"].nil?
      # Exits non-zero while checks are pending or failing; prints nothing as long as none reported.
      checks = Open3.capture2("gh", "pr", "checks", branch, "--required", "--json", "name,bucket").first
      checks = checks.start_with?("[") ? JSON.parse(checks) : []
      failed = checks.filter_map { |check| check["name"] if check["bucket"] == "fail" }
      abort "#{url}: #{failed.join(", ")} failed. Fix it on #{branch}; #{resume}" if failed.any?
    end
    sleep 20
  rescue Interrupt
    abort "\nStopped waiting: #{resume}"
  end
  # The run starts a few seconds after the merge: until then, the list is empty.
  url = 30.times do
    found = Open3.capture2("gh", "run", "list", "--workflow", "release.yml", "--commit", commit, "--json", "url", "--jq", ".[0].url").first.strip
    break found unless found.empty?
    sleep 5
  end
  url = "#{repo_url}/actions/workflows/release.yml" unless url.is_a?(String)
  puts "Merged: #{url} tags #{commit[0, 7]} #{tag} and publishes it once the release environment is approved"
  begin
    Open3.capture2e(RUBY_PLATFORM.include?("darwin") ? "open" : "xdg-open", url) if $stdout.tty?
  rescue SystemCallError # no browser to open: the link above is enough
  end
  # Local housekeeping, once merged: a failure here only warns.
  Open3.capture2e("git", "fetch", "--quiet", "--tags", "origin", "main")
  if run("git", "branch", "--show-current").strip == "main" && run("git", "status", "--porcelain", "--untracked-files=no").empty?
    output, status = Open3.capture2e("git", "merge", "--quiet", "--ff-only", "origin/main")
    warn "main not fast-forwarded to origin/main:\n#{output}" unless status.success?
  end
  Open3.capture2e("git", "branch", "--quiet", "--delete", "--force", branch)
end

mode = :release
dry_run = false
write_only = false
assume_yes = false
OptionParser.new do |parser|
  parser.banner = "Usage: bin/release (patch | minor | major | X.Y.Z) [--dry-run | --write] [--yes] | --wait X.Y.Z"
  parser.on("--dry-run", "Show the notes and the changes, touch nothing") { dry_run = true }
  parser.on("--yes", "Do not ask before opening the release pull request") { assume_yes = true }
  parser.on("--write", "Write the changes and stop, for a pull request opened by hand") { write_only = true }
  parser.on("--wait", "Wait for the release pull request of the version given to merge") { mode = :wait }
  parser.on("--check", "Fail unless the tag given matches the gemspec's version and has notes") { mode = :check }
  parser.on("--commit", "Print the release commit of the tag given") { mode = :commit }
  parser.on("--notes", "Print the release notes of the tag given") { mode = :notes }
  parser.on("--title", "Print the release title of the tag given") { mode = :title }
end.parse!
argument = ARGV.shift or abort "Which version? patch, minor, major or X.Y.Z (bin/release --help)"

if mode != :release
  version = argument.delete_prefix("v")
  notes = changelog[section(version), 1].to_s.strip
  case mode
  when :check
    abort "Tag #{argument}, but #{spec.name}.gemspec says #{current}" unless version == current.to_s
    abort "#{CHANGELOG} has no notes for #{version}" if notes.empty?
    puts "#{argument} matches #{spec.name} #{current}"
  when :commit
    # Notes and version may reach main in separate commits: the release is the one that completes the pair, the
    # oldest of the first-parent commits that, from HEAD back, all have both.
    abort "Tag #{argument}, but #{spec.name}.gemspec says #{current}" unless version == current.to_s
    abort "A shallow clone may not reach #{version}'s release commit: fetch the whole history" if run("git", "rev-parse", "--is-shallow-repository").strip == "true"
    versions = {}
    missing = lambda do |commit|
      written = run("git", "show", "#{commit}:#{CHANGELOG}") unless run("git", "ls-tree", "--name-only", commit, "--", CHANGELOG).empty?
      next "notes" if written.nil? || written.force_encoding(Encoding::UTF_8)[section(version), 1].to_s.strip.empty?
      # The gemspec's version in that commit's own tree: the version file may have moved since, or hold several.
      # Loaded once per state of lib/ and the gemspec, which most commits leave alone.
      key = run("git", "ls-tree", commit).lines.grep(%r{\t(lib|[^/]*\.gemspec)$}).join
      found = versions[key] ||= Dir.mktmpdir do |dir|
        tree = File.join(dir, "tree")
        run("git", "worktree", "add", "--quiet", "--detach", tree, commit)
        run(RbConfig.ruby, "-e", 'Dir["*.gemspec"].first&.then { puts Gem::Specification.load(_1)&.version || exit(1) }', chdir: tree).strip
      ensure
        Open3.capture2e("git", "worktree", "remove", "--force", tree)
      end
      "version (#{found.empty? ? "no gemspec" : found})" unless found == version
    end
    commits = run("git", "rev-list", "--first-parent", "HEAD").split
    gap = nil
    release = commits.take_while { |commit| !(gap = missing.call(commit)) }.last
    abort "HEAD #{commits.first[0, 7]} lacks #{version}'s #{gap}" unless release
    puts release
  when :notes
    abort "#{CHANGELOG} has no notes for #{version}" if notes.empty?
    compare = changelog.scan(REFERENCE).to_h[version]
    puts notes
    puts "", "**Full diff**: #{compare}" if compare&.include?("/compare/")
  when :title
    puts "#{display_name} #{version}"
  when :wait
    publish.call(Gem::Version.new(version))
  end
  exit
end

major, minor, patch = current.segments.first(3).fill(0, current.segments.size...3)
target = Gem::Version.new(
  case argument
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  when "patch" then "#{major}.#{minor}.#{patch + 1}"
  else argument.delete_prefix("v")
  end
)
tag = "v#{target}"

# The tree, the branch, the tags and CI.
# CHANGELOG.md alone may be uncommitted: the notes written for this release, committed with the version.
uncommitted = run("git", "status", "--short", "--", ".", ":(exclude)#{CHANGELOG}")
abort "Uncommitted changes:\n#{uncommitted}" unless uncommitted.empty?
branch = run("git", "branch", "--show-current").strip
abort "On #{branch}: releases are cut from main" unless branch == "main"
run("git", "fetch", "--quiet", "--tags", "origin", "main")
head = run("git", "rev-parse", "HEAD").strip
abort "main is not origin/main: pull or push first" unless head == run("git", "rev-parse", "origin/main").strip
released = run("git", "tag", "--list", "v*").split.map { |name| Gem::Version.new(name.delete_prefix("v")) }
abort "#{target} is not above #{released.max}, the last release" if released.any? && target <= released.max
abort "#{target} is below #{current}, the gemspec's version" if target < current
previous = released.max
# The gemspec's version merged with its notes but unpublished: its release run waits for approval, or stopped.
# Released once its GitHub release exists, as for release.yml. Its notes count as committed when releasing that same
# version again (its release commit stays the earlier one) or once tagged (the tag is out), as they stand otherwise
# (moved back under Unreleased, they go with the next version).
pending_notes = (target == current || released.include?(current)) ? Open3.capture3("git", "show", "HEAD:#{CHANGELOG}").first.force_encoding(Encoding::UTF_8) : changelog
unless pending_notes[section(current.to_s), 1].to_s.strip.empty?
  tagged = released.include?(current)
  published = tagged
  if tagged # without gh (--write, for setups without it), the tag decides
    path = "repos/#{repo_url.to_s[%r{github\.com/([^/]+/[^/#?]+?)(?:\.git)?/?\z}, 1] || "{owner}/{repo}"}/releases/tags/v#{current}"
    output, status = begin
      Open3.capture2e("gh", "api", path, "--silent")
    rescue SystemCallError => exception
      [exception.message, nil]
    end
    if status&.success? then published = true
    elsif output.include?("HTTP 404") then published = false
    elsif !write_only then abort "gh api #{path} failed:\n#{output}"
    end
  end
  unless published
    advice = tagged ? "Run it again" : "Approve it, or run it again; to release over it instead, reject it, move " \
      "#{current}'s notes back under Unreleased and release the next version"
    abort "#{current} is merged but not published: its release run (#{repo_url}/actions/workflows/release.yml) " \
      "waits or stopped. #{advice}"
  end
end

# The release pull request's own CI still runs before it merges: --write, for setups without gh, skips this check.
runs = write_only ? [{"conclusion" => "success"}] : JSON.parse(run("gh", "run", "list", "--commit", head, "--workflow", "ci.yml", "--json", "status,conclusion,url"))
unless runs.first&.fetch("conclusion") == "success"
  state = runs.first ? runs.first.values_at("status", "conclusion", "url").join(" ").squeeze(" ") : "no run"
  abort "CI is not green on #{head[0, 7]} (#{state}): wait for it, or fix it"
end

# CHANGELOG.md: the Unreleased entries become the version's section, unless a commit already wrote it.
unreleased = changelog[section("Unreleased"), 1].to_s.strip
if changelog.match?(section(target.to_s))
  abort "#{CHANGELOG} has a #{target} section and Unreleased entries: move them" unless unreleased.empty?
else
  abort "#{CHANGELOG}'s Unreleased section is empty: nothing to release" if unreleased.empty?
  changelog = changelog.sub(section("Unreleased")) { "## [Unreleased]\n\n## [#{target}] — #{Date.today.iso8601}\n\n#{unreleased}\n\n" }
end

# Reference links at the end: Unreleased compares with the new tag, then each version newest first.
references = changelog.scan(REFERENCE).to_h
references.delete(current.to_s) unless changelog.match?(section(current.to_s)) # its notes moved to the target
references["Unreleased"] = "#{repo_url}/compare/#{tag}...HEAD"
references[target.to_s] = previous ? "#{repo_url}/compare/v#{previous}...#{tag}" : "#{repo_url}/releases/tag/#{tag}"
unreleased_link = references.delete("Unreleased")
versions = references.sort_by { |name, _url| Gem::Version.new(name) }.reverse
links = [["Unreleased", unreleased_link], *versions].map { |name, url| "[#{name}]: #{url}" }
changelog = "#{changelog.gsub(/^#{REFERENCE.source}\n?/, "").rstrip}\n\n#{links.join("\n")}\n"

# The version constant, and Gemfile.lock where it is committed.
changes = {CHANGELOG => changelog}
if target != current
  constant = /^(\s*VERSION = )(["'])#{Regexp.escape(current.to_s)}\2/
  holders = Dir["lib/**/version.rb"].select { |path| File.read(path).match?(constant) }
  abort "Expected one VERSION = \"#{current}\" in lib/**/version.rb, found #{holders}" unless holders.one? && File.read(holders.first).scan(constant).one?
  changes[holders.first] = File.read(holders.first).sub(constant) { "#{$1}#{$2}#{target}#{$2}" }
  unless run("git", "ls-files", "Gemfile.lock").empty?
    lock = File.read("Gemfile.lock").sub(/^(    #{Regexp.escape(spec.name)} \()#{Regexp.escape(current.to_s)}\)/) { "#{$1}#{target})" }
    changes["Gemfile.lock"] = lock
  end
end
changes.reject! { |path, text| File.read(path, encoding: "UTF-8") == text }

puts "#{display_name} #{current} → #{target}, through a pull request, then tagged #{tag} by release.yml", ""
puts changelog[section(target.to_s), 1].strip, ""
if dry_run
  changes.each do |path, text|
    Tempfile.create do |file|
      file.write(text)
      file.flush
      diff = Open3.capture2("git", "diff", "--no-index", "--src-prefix=", "--dst-prefix=", path, file.path).first.force_encoding(Encoding::UTF_8)
      puts diff.gsub(/\S*#{Regexp.escape(File.basename(file.path))}/, path)
    end
  end
  puts "Dry run: nothing written"
  exit
end

abort "Nothing to change for #{target}: if its pull request merged, release.yml publishes it" if changes.empty?
if write_only
  changes.each { |path, text| File.write(path, text) }
  puts "Wrote #{changes.keys.join(", ")}: once a pull request merges them into main, release.yml publishes #{tag}"
  exit
end
unless assume_yes
  print "Open the release pull request, which publishes #{spec.name} #{target} once it merges and you approve? [y/N] "
  abort "Stopped" unless $stdin.gets.to_s.strip.casecmp?("y")
end

branch = "release/#{tag}"
title = "Release #{target}"
body = "#{changelog[section(target.to_s), 1].strip}\n\nOnce merged, the release workflow tags the merge commit " \
  "#{tag} and publishes the gem, after the release environment's approval."
begin
  run("git", "switch", "--quiet", "--create", branch)
  changes.each { |path, text| File.write(path, text) }
  run("git", "commit", "--quiet", "-m", title, "--", *changes.keys)
  run("git", "push", "--quiet", "origin", branch)
  run("git", "switch", "--quiet", "main")
  run("gh", "pr", "create", "--base", "main", "--head", branch, "--title", title, "--body", body)
  run("gh", "pr", "merge", branch, "--auto", "--squash")
rescue SystemExit
  warn "Stopped before #{branch}'s pull request merges by itself. Either finish by hand (open it, merge it, then " \
    "release.yml publishes it), or undo and start again: git switch main && git branch -D #{branch} && " \
    "git push origin :#{branch} (the notes are in #{branch}'s commit)"
  raise
end
puts "Opened #{JSON.parse(run("gh", "pr", "view", branch, "--json", "url"))["url"]}: it merges itself once CI is green"
publish.call(target)
